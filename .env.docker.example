# Copy to .env.docker:  cp .env.docker.example .env.docker   (keeps it separate from your local .env)
MYSQL_ROOT_PASSWORD=change-me-db
SESSION_SECRET=change-me-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-min-8-chars
# Optional: shared key for ESP32 devices; host port for the dashboard
DEVICE_API_KEY=
APP_PORT=3000
# Let visitors sign themselves up as read-only viewers (true/false)
ALLOW_SIGNUP=true
