PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_water
# Minutes without a reading before a dispenser is marked OFFLINE
OFFLINE_AFTER_MIN=2
# Defaults for alerts (each dispenser can override them in its Edit form)
# Percent level under which a LOW_LEVEL alert is raised
LOW_LEVEL_PCT=20
# Water temperature (°C) above which a HIGH_TEMP alert is raised
HIGH_TEMP_C=25
# Shared secret ESP32 devices send in the x-api-key header (leave empty to disable)
DEVICE_API_KEY=
# Secret used to sign login cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=
# Let people create their own (read-only viewer) account from the login page
ALLOW_SIGNUP=true

# --- Password reset email (optional). Without SMTP_HOST the reset link is printed in the server log. ---
BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smart Water <no-reply@example.com>"

# --- Alert emails to admins who have an email address (uses the SMTP settings above) ---
# ALERT_EMAILS=false        # turn them off
# ALERT_COOLDOWN_MIN=30     # minimum minutes between emails for the same dispenser + alert type

# --- Sample data ---
# On first start with an empty database, 5 demo dispensers are created. Set false to start empty and use real devices only.
SEED_DEMO=false

# --- Production (see DEPLOY.md) ---
# COOKIE_SECURE=true     # when served over HTTPS
# TRUST_PROXY=1          # when behind a reverse proxy / hosting platform
# DATABASE_URL=mysql://user:pass@host:3306/dbname   # alternative to DB_*
# DB_SSL=true            # for managed MySQL that requires TLS
