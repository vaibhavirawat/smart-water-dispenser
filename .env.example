PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_water
# Minutes without a reading before a dispenser is marked OFFLINE
OFFLINE_AFTER_MIN=2
# Percent level under which a LOW_LEVEL alert is raised
LOW_LEVEL_PCT=20
# Shared secret ESP32 devices send in the x-api-key header (leave empty to disable)
DEVICE_API_KEY=
# Secret used to sign login cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=
